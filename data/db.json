      "itinerary": [
        {
          "day": 1,
          "title": "Pick up from Surabaya & Bromo Mountain Check-in",
          "description": "Pick up from Surabaya Airport/Train Station. Enjoy a private scenic 4-hour drive to Cemoro Lawang village. Check into your cozy room sitting directly on the rim of the Tengger Caldera.",
          "timeSchedules": [
            {
              "time": "12:00",
              "activity": "Surabaya airport pickup & meet private driver"
            },
            {
              "time": "16:00",
              "activity": "Check-in at mountain caldera overlook lodge"
            }
          ]
        },
        {
          "day": 2,
          "title": "Bromo Sunrise, Crater Trek & Banyuwangi Drive",
          "description": "Wake up at 3:00 AM. Board your private 4x4 Jeep to Penanjakan viewpoint to witness the world-famous sunrise over Mt. Bromo. Afterward, cross the Whispering Sand and hike 250 steps to Bromo's crater rim. Transfer drive to Banyuwangi.",
          "timeSchedules": [
            {
              "time": "03:00",
              "activity": "Board 4x4 Offroad Jeep to sunrise overlook"
            },
            {
              "time": "08:00",
